    {
      "id": "-bdKlysqJShyWRF-7sNVs",
      "type": "text",
      "x": 1035.3603919845398,
      "y": -122.59031911669015,
      "width": 453.2955322265625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
