      "isDeleted": false,
      "boundElements": [],
      "updated": 1787315788022,
      "link": null,
      "locked": false,
      "text": "El accessToken se pierde, pero la cookie puede seguir viva.\nuseAuthUser necesita recuperar la sesión → aparece un 401 →\nhttpClient hace refresh → la sesión se reconstruye.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "El accessToken se pierde, pero la cookie puede seguir viva.\nuseAuthUser necesita recuperar la sesión → aparece un 401 →\nhttpClient hace refresh → la sesión se reconstruye.",
      "lineHeight": 1.25,
      "autoResize": false,
      "index": "bKe"
    },
