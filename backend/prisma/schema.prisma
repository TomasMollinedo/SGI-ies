// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model USUARIO {
  id_usuario Int    @id @default(autoincrement())
  nombre     String
  apellido   String
  email      String @unique
  password   String // hash de bcrypt, nunca texto plano

  FK_rol Int
  rol    ROL @relation(fields: [FK_rol], references: [id_rol])

  refreshTokenHash String? // hash bcrypt del refresh token vigente; null si no hay sesión activa
  dni              String  @unique

  // Relaciones
  tiposMovimientoCreados      TIPOMOVIMIENTO[] @relation("TipoMovimientoCreador")
  tiposMovimientoActualizados TIPOMOVIMIENTO[] @relation("TipoMovimientoActualizador")

  movimientosCreados      MOVIMIENTO[] @relation("MovimientoCreador")
  movimientosActualizados MOVIMIENTO[] @relation("MovimientoActualizador")

  articulosCreados      ARTICULO[] @relation("ArticuloCreador")
  articulosActualizados ARTICULO[] @relation("ArticuloActualizador")

  categoriasCreadas      CATEGORIA[] @relation("CategoriaCreador")
  categoriasActualizadas CATEGORIA[] @relation("CategoriaActualizador")

  marcasCreadas      MARCA[] @relation("MarcaCreador")
  marcasActualizadas MARCA[] @relation("MarcaActualizador")

  unidadesMedidaCreadas      UNIDADMEDIDA[] @relation("UnidadMedidaCreador")
  unidadesMedidaActualizadas UNIDADMEDIDA[] @relation("UnidadMedidaActualizador")

  depositosCreados      DEPOSITO[] @relation("DepositoCreador")
  depositosActualizados DEPOSITO[] @relation("DepositoActualizador")

  stocksCreados      STOCK[] @relation("StockCreador")
  stocksActualizados STOCK[] @relation("StockActualizador")

  // Alertas que este usuario marcó como atendidas. No hay relación de
  // "creador": las alertas las genera el sistema, no una persona.
  alertasAtendidas ALERTA[]

  // Ciclo de gastos (Sprint 2)
  proveedoresCreados      PROVEEDOR[] @relation("ProveedorCreador")
  proveedoresActualizados PROVEEDOR[] @relation("ProveedorActualizador")

  ordenesCompraCreadas      ORDENCOMPRA[]                @relation("OrdenCompraCreador")
  ordenesCompraActualizadas ORDENCOMPRA[]                @relation("OrdenCompraActualizador")
  ordenesCompraHistorial    ORDENCOMPRAHISTORIALESTADO[] @relation("OrdenCompraHistorialUsuario")

  tiposComprobanteCreados      TIPOCOMPROBANTE[] @relation("TipoComprobanteCreador")
  tiposComprobanteActualizados TIPOCOMPROBANTE[] @relation("TipoComprobanteActualizador")

  formasPagoCreadas      FORMAPAGO[] @relation("FormaPagoCreador")
  formasPagoActualizadas FORMAPAGO[] @relation("FormaPagoActualizador")

  comprobantesProveedorCreados      COMPROBANTEPROVEEDOR[] @relation("ComprobanteProveedorCreador")
  comprobantesProveedorActualizados COMPROBANTEPROVEEDOR[] @relation("ComprobanteProveedorActualizador")

  pagosCreados      PAGO[] @relation("PagoCreador")
  pagosActualizados PAGO[] @relation("PagoActualizador")

  // Comercialización / Ecommerce (Sprint 3)
  proyectosCreados      PROYECTO[] @relation("ProyectoCreador")
  proyectosActualizados PROYECTO[] @relation("ProyectoActualizador")

  unidadesFuncionalesCreadas      UNIDADFUNCIONAL[] @relation("UnidadFuncionalCreador")
  unidadesFuncionalesActualizadas UNIDADFUNCIONAL[] @relation("UnidadFuncionalActualizador")

  publicacionesCreadas      PUBLICACIONUNIDAD[] @relation("PublicacionCreador")
  publicacionesActualizadas PUBLICACIONUNIDAD[] @relation("PublicacionActualizador")

  planesPagoCreados      PLANPAGO[]          @relation("PlanPagoCreador")
  planesPagoActualizados PLANPAGO[]          @relation("PlanPagoActualizador")
  planesPagoHistorial    PLANPAGOHISTORIAL[] @relation("PlanPagoHistorialUsuario")

  consultasRespondidas CONSULTAUNIDAD[] @relation("ConsultaUnidadRespuesta")

  cobrosCreados      COBRO[] @relation("CobroCreador")
  cobrosActualizados COBRO[] @relation("CobroActualizador")

  declaracionesPagoValidadas DECLARACIONPAGO[] @relation("DeclaracionPagoValidador")
}

model ROL {
  id_rol Int    @id @default(autoincrement())
  nombre String @unique

  usuarios USUARIO[]

  // Alertas dirigidas a este rol: el destinatario de una alerta es un puesto,
  // no una persona.
  alertas ALERTA[]
}

model TIPOMOVIMIENTO {
  id_tipo_movimiento Int     @id @default(autoincrement())
  nombre             String  @unique
  descripcion        String?
  indicador_entrada  Boolean // Indica si el movimiento es de entrada (true) o de salida (false)
  estado             Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("TipoMovimientoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("TipoMovimientoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  movimientos MOVIMIENTO[]
}

model MOVIMIENTO {
  id_movimiento    Int      @id @default(autoincrement())
  // Fecha "de negocio" del movimiento, la carga el usuario. Distinta de
  // hora_creacion, que es el timestamp técnico de cuándo se creó la fila.
  fecha_movimiento DateTime
  observaciones    String?
  referencia       String? // Referencia externa (ejemplo: número de factura, remito, etc.)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_TipoMovimiento       Int
  FK_Deposito             Int
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  tipoMovimiento      TIPOMOVIMIENTO @relation(fields: [FK_TipoMovimiento], references: [id_tipo_movimiento])
  deposito            DEPOSITO       @relation("MovimientoDeposito", fields: [FK_Deposito], references: [id_deposito])
  usuarioCreador      USUARIO        @relation("MovimientoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO        @relation("MovimientoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stockMovimientos STOCKMOVIMIENTO[]
}

model STOCKMOVIMIENTO {
  id_stock_movimiento Int     @id @default(autoincrement())
  // Cantidad de la línea. El signo del efecto sobre el stock lo define
  // TIPOMOVIMIENTO.indicador_entrada del movimiento de cabecera, no este campo.
  cantidad            Int
  // Foto del stock antes y después de aplicar esta línea: es el log de
  // auditoría que pide HU-07 (quién y cuándo salen del MOVIMIENTO de cabecera).
  stock_anterior      Int
  stock_nuevo         Int
  observacion         String?

  FK_Movimiento Int
  FK_Stock      Int

  movimiento MOVIMIENTO @relation(fields: [FK_Movimiento], references: [id_movimiento])
  stock      STOCK      @relation(fields: [FK_Stock], references: [id_stock])

  // El cardex de una ficha de stock filtra exactamente por esta columna.
  // Postgres no indexa las claves foráneas por su cuenta, así que va explícito.
  @@index([FK_Stock])
}

model STOCK {
  id_stock      Int     @id @default(autoincrement())
  // Cantidad actual de ese artículo en ese depósito/obrador. La mantiene al
  // día el módulo de Movimientos (entradas/salidas); arranca en 0 al crear
  // la ficha y no es editable directamente.
  cantidad      Int     @default(0)
  umbral_minimo Int     @default(0)
  observaciones String?
  // Único solo entre fichas activas (se valida a nivel service, no acá): no
  // puede haber otra ficha activa para la misma combinación artículo-depósito.
  estado        Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_deposito             Int
  FK_articulo             Int
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  deposito DEPOSITO @relation(fields: [FK_deposito], references: [id_deposito])
  articulo ARTICULO @relation(fields: [FK_articulo], references: [id_articulo])

  usuarioCreador      USUARIO @relation("StockCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("StockActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stockMovimientos STOCKMOVIMIENTO[]
}

model ARTICULO {
  id_articulo Int     @id @default(autoincrement())
  // Único solo entre artículos activos (se valida a nivel service, no acá):
  // un artículo dado de baja libera su nombre para uno nuevo.
  nombre      String
  descripcion String?
  estado      Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_Categoria            Int
  FK_Marca                Int?
  FK_UnidadMedida         Int
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  categoria    CATEGORIA    @relation(fields: [FK_Categoria], references: [id_categoria])
  marca        MARCA?       @relation(fields: [FK_Marca], references: [id_marca])
  unidadMedida UNIDADMEDIDA @relation(fields: [FK_UnidadMedida], references: [id_unidad_medida])

  usuarioCreador      USUARIO @relation("ArticuloCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("ArticuloActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stocks STOCK[]

  detallesOrdenCompra DETALLEORDENCOMPRA[]
  detallesComprobante DETALLECOMPROBANTE[]
}

model CATEGORIA {
  id_categoria Int     @id @default(autoincrement())
  // Único solo entre categorías activas (se valida a nivel service, no acá):
  // una categoría dada de baja libera su nombre para una categoría nueva.
  nombre       String
  descripcion  String?
  estado       Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("CategoriaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("CategoriaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model MARCA {
  id_marca    Int     @id @default(autoincrement())
  // Único solo entre marcas activas (se valida a nivel service, no acá):
  // una marca dada de baja libera su nombre para una marca nueva.
  nombre      String
  descripcion String?
  estado      Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("MarcaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("MarcaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model UNIDADMEDIDA {
  id_unidad_medida Int     @id @default(autoincrement())
  nombre           String
  abreviatura      String // Abreviatura de la unidad de medida (ejemplo: kg, m, l, etc.)
  estado           Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("UnidadMedidaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("UnidadMedidaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model DEPOSITO {
  id_deposito Int     @id @default(autoincrement())
  // Único solo entre depósitos/obradores activos (se valida a nivel service,
  // no acá): uno dado de baja libera su nombre para uno nuevo.
  nombre      String
  es_obrador  Boolean @default(false)
  ubicacion   String?
  descripcion String?
  estado      Boolean @default(true)

  // Opcional: un depósito central puede no estar vinculado a ningún proyecto.
  FK_Proyecto Int?
  proyecto    PROYECTO? @relation(fields: [FK_Proyecto], references: [id_proyecto])

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("DepositoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("DepositoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stocks STOCK[]

  movimientos MOVIMIENTO[] @relation("MovimientoDeposito")

  ordenesCompra ORDENCOMPRA[] @relation("OrdenCompraDeposito")
}

// Hasta Sprint 2 era un stub con solo el id, para poder vincular
// (opcionalmente) un depósito/obrador a un proyecto. Sprint 3 lo completa con
// los campos que Comercialización necesita para publicar unidades. Sigue sin
// ABM propio en este sprint: se carga por seed (ver prisma/seed.ts), mismo
// criterio que ROL o TIPOALERTA — el ABM completo de Proyecto queda para un
// sprint futuro.
model PROYECTO {
  id_proyecto Int @id @default(autoincrement())

  codigo String @unique

  nombre    String
  localidad String
  // Nullable a propósito: un proyecto en planificación puede no tener
  // dirección todavía.
  direccion String?

  // Null → la ficha pública de la unidad muestra "A entregar, fecha a
  // confirmar" en vez de una fecha (HU-21).
  fecha_fin_estimada DateTime?

  estado EstadoProyecto @default(EN_PLANIFICACION)

  // Informativo: no bloquea ni se valida contra la cantidad de unidades
  // cargadas.
  cantidad_unidades_planificadas Int?

  // Única pieza de contenido de la landing (HU-24) que no puede vivir
  // hardcodeada en el frontend: depende de qué proyecto salga como
  // destacado, así que tiene que salir de acá.
  imagen_portada_url String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("ProyectoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("ProyectoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  depositos           DEPOSITO[]
  unidadesFuncionales UNIDADFUNCIONAL[]

  // No existe columna `presupuesto`: se deriva como SUM(costo) de las
  // unidades funcionales activas del proyecto, se calcula al leer (ver DER
  // Sprint 3).

  @@index([estado])
}

// Tabla de referencia de los tipos de alerta que puede generar el sistema.
// Mismo criterio que ROL: la da de alta un desarrollador al escribir una
// funcionalidad nueva, no un usuario de negocio desde una pantalla. Por eso no
// lleva ABM, ni auditoría, ni `estado`: si un tipo deja de usarse, el código
// simplemente deja de generarlo.
model TIPOALERTA {
  id_tipo_alerta Int     @id @default(autoincrement())
  nombre         String  @unique // "REPOSICION" — identificador estable, lo usa el código
  descripcion    String? // qué dispara este tipo, para quien lo lea después

  alertas ALERTA[]
}

// Condición de negocio detectada por algún módulo. Hoy la única fuente es el
// cruce del umbral mínimo de stock que detecta MovimientoService, pero el
// modelo es transversal: cualquier dominio puede generar sus propias alertas
// sin tocar el schema, sumando un tipo a TIPOALERTA.
//
// No lleva FK_usuario_creador/actualizador a propósito: es un registro
// generado por el sistema como efecto de una condición, no algo que un
// usuario cree o edite.
model ALERTA {
  id_alerta Int @id @default(autoincrement())

  FK_tipo_alerta Int
  tipoAlerta     TIPOALERTA @relation(fields: [FK_tipo_alerta], references: [id_tipo_alerta])

  mensaje String // texto ya armado, listo para mostrar sin interpretar `datos`
  // Payload específico del tipo: ids involucrados y valores puntuales (para
  // REPOSICION, por ejemplo, stockId, movimientoId, stockNuevo, umbralMinimo).
  // Es Json? a propósito, para que un tipo futuro con otra forma no necesite
  // una migración; la base no valida su contenido, eso queda en la capa de
  // aplicación.
  datos   Json?

  // Identifica la condición en curso que originó la alerta, ej "REPOSICION-42"
  // (tipo + id de la entidad afectada). Sirve para no volver a alertar por algo
  // que ya está reportado y sin atender.
  //
  // Sin @unique a propósito: la unicidad que importa es "única entre las no
  // atendidas", que se valida a nivel service — mismo criterio que el nombre
  // único entre activos de MARCA o CATEGORIA. Una vez atendida, la clave queda
  // libre para que la condición vuelva a alertar si sigue vigente.
  clave_deduplicacion String

  // El destinatario es un rol y no un usuario: la alerta le importa a quien
  // sea que ocupe ese puesto, no a una persona puntual.
  FK_rol_destinatario Int
  rolDestinatario     ROL @relation(fields: [FK_rol_destinatario], references: [id_rol])

  atendida            Boolean   @default(false)
  FK_usuario_atencion Int?
  fecha_atencion      DateTime?

  hora_creacion DateTime @default(now())

  usuarioAtencion USUARIO? @relation(fields: [FK_usuario_atencion], references: [id_usuario])
}

// ============================================================================
// CICLO DE GASTOS (Sprint 2) — Compras + Tesorería (HU-12 a HU-18)
// ============================================================================

// Condición del proveedor frente al IVA. Conjunto cerrado por normativa, no
// es un dato que el usuario pueda dar de alta.
enum CondicionIVA {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  CONSUMIDOR_FINAL
}

// Estados de la orden de compra. Van como enum y no como tabla paramétrica:
// los cinco valores y sus transiciones permitidas son lógica de negocio
// validada en el service, no datos administrables desde una pantalla.
enum EstadoOrdenCompra {
  BORRADOR
  EMITIDA
  RECIBIDA_PARCIAL
  RECIBIDA
  CANCELADA
}

// Situación del documento comprobante (distinta de su estado de saldo).
enum EstadoComprobante {
  BORRADOR
  REGISTRADO
  ANULADO
}

enum EstadoPago {
  BORRADOR
  CONFIRMADA
  ANULADA
}

// --------------------------------------------------------------------------
// HU-12 — Proveedores
// --------------------------------------------------------------------------
model PROVEEDOR {
  // El "código único generado por el sistema" que pide la HU es esta PK: no
  // hay campo `codigo` aparte.
  id_proveedor Int @id @default(autoincrement())

  // Sin @unique a propósito: la unicidad de la razón social es solo entre
  // proveedores activos y la valida el service (mismo criterio que MARCA).
  razon_social  String
  // Único a nivel de base, y es el único índice único de negocio de los datos
  // maestros del sprint: el CUIT identifica a una persona jurídica, así que
  // duplicarlo aunque sea contra un proveedor inactivo es un error de datos.
  // Si un proveedor dado de baja vuelve, se reactiva, no se recrea. El formato
  // (once dígitos) lo valida Zod en el service, no la base.
  cuit          String       @unique
  condicion_iva CondicionIVA
  domicilio     String?
  telefono      String?
  correo        String?

  // Datos bancarios, todos opcionales. Son la fuente de la foto que guarda
  // PAGO (banco_utilizado, titular_utilizado, etc.) al confirmar. El formato
  // del CBU (22 dígitos) y del alias (6 a 20 caracteres) lo valida Zod en el
  // service, no la base — mismo criterio que el CUIT.
  banco   String?
  titular String?
  cbu     String?
  alias   String?

  observaciones String?
  estado        Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("ProveedorCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("ProveedorActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  ordenesCompra ORDENCOMPRA[]
  comprobantes  COMPROBANTEPROVEEDOR[]
  pagos         PAGO[]

  // El listado por defecto muestra solo activos.
  @@index([estado])
}

// --------------------------------------------------------------------------
// HU-13 — Órdenes de compra
// --------------------------------------------------------------------------
model ORDENCOMPRA {
  // El número de orden que ve el usuario es esta PK: la secuencia de Postgres
  // ya es segura ante concurrencia, no hace falta un servicio de numeración.
  id_orden_compra Int @id @default(autoincrement())

  // Fecha "de negocio" que carga el usuario, distinta de hora_creacion. El
  // default "hoy" y el rechazo de fechas futuras los aplica el service.
  fecha_emision            DateTime
  fecha_entrega_solicitada DateTime?

  // Texto libre: observación general de la orden (alta/edición en BORRADOR).
  // La observación de cada cambio de estado NO pisa este campo — queda en su
  // propia fila de ORDENCOMPRAHISTORIALESTADO (ver ese modelo).
  observaciones String?

  // Lo calcula el sistema a partir del detalle, nunca lo manda el cliente.
  total  Decimal           @default(0) @db.Decimal(14, 2)
  estado EstadoOrdenCompra @default(BORRADOR)

  // Obligatorio a nivel de service cuando el estado pasa a CANCELADA.
  motivo_cancelacion String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_proveedor            Int
  FK_deposito             Int
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  proveedor           PROVEEDOR @relation(fields: [FK_proveedor], references: [id_proveedor])
  deposito            DEPOSITO  @relation("OrdenCompraDeposito", fields: [FK_deposito], references: [id_deposito])
  usuarioCreador      USUARIO   @relation("OrdenCompraCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO   @relation("OrdenCompraActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  detalles         DETALLEORDENCOMPRA[]
  comprobantes     COMPROBANTEPROVEEDOR[]
  historialEstados ORDENCOMPRAHISTORIALESTADO[]

  // Filtros combinables del listado: proveedor, estado, depósito y período.
  @@index([FK_proveedor])
  @@index([estado])
  @@index([FK_deposito])
  @@index([fecha_emision])
}

/**
 * Historial de HU-13: una fila por cada transición manual de estado de una
 * orden de compra (BORRADOR → EMITIDA → RECIBIDA_PARCIAL/RECIBIDA/CANCELADA).
 * El alta en BORRADOR no genera fila acá — no es una transición, es el
 * estado inicial de la orden — por eso `estado_anterior` siempre tiene valor.
 * Append-only — nunca se edita ni se borra una fila, por eso no tiene
 * `hora_actualizacion` ni `FK_usuario_actualizador` (mismo criterio que
 * ALERTA, que tampoco los tiene por no ser una entidad editable).
 */
model ORDENCOMPRAHISTORIALESTADO {
  id_historial    Int               @id @default(autoincrement())
  estado_anterior EstadoOrdenCompra
  estado_nuevo    EstadoOrdenCompra
  observacion     String?
  fecha           DateTime          @default(now())

  FK_orden_compra Int
  FK_usuario      Int

  ordenCompra ORDENCOMPRA @relation(fields: [FK_orden_compra], references: [id_orden_compra])
  usuario     USUARIO     @relation("OrdenCompraHistorialUsuario", fields: [FK_usuario], references: [id_usuario])

  @@index([FK_orden_compra])
}

model DETALLEORDENCOMPRA {
  id_detalle_orden_compra Int @id @default(autoincrement())

  FK_orden_compra Int
  FK_articulo     Int

  // La cantidad también es Decimal: los artículos tienen unidad de medida y no
  // todos se cuentan en unidades enteras.
  cantidad        Decimal @db.Decimal(14, 2)
  precio_unitario Decimal @db.Decimal(14, 2)
  subtotal        Decimal @db.Decimal(14, 2)

  ordenCompra ORDENCOMPRA @relation(fields: [FK_orden_compra], references: [id_orden_compra], onDelete: Cascade)
  articulo    ARTICULO    @relation(fields: [FK_articulo], references: [id_articulo])

  // Un mismo artículo no se repite en dos líneas de la misma orden. Este único
  // sí va en la base: no tiene el problema de convivir con documentos anulados.
  @@unique([FK_orden_compra, FK_articulo])
}

// --------------------------------------------------------------------------
// HU-14 — Tipos de comprobante
// --------------------------------------------------------------------------
model TIPOCOMPROBANTE {
  id_tipo_comprobante Int @id @default(autoincrement())

  // Sin @unique: la unicidad del nombre es solo entre activos, la valida el
  // service.
  nombre      String
  descripcion String?

  // aumenta_saldo se fija en el alta y queda bloqueado de forma permanente:
  // cambiarlo después reinterpretaría todos los comprobantes ya registrados
  // con este tipo. Esa inmutabilidad la aplica el service, la base no puede
  // expresarla.
  //
  // Va como Boolean y no como enum, mismo criterio que
  // TIPOMOVIMIENTO.indicador_entrada: son solo dos valores posibles.
  aumenta_saldo Boolean // Aumenta el saldo del proveedor (true) o lo disminuye (false)

  estado Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("TipoComprobanteCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("TipoComprobanteActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  comprobantes COMPROBANTEPROVEEDOR[]

  @@index([estado])
}

// --------------------------------------------------------------------------
// HU-15 — Formas de pago
// --------------------------------------------------------------------------
model FORMAPAGO {
  id_forma_pago Int @id @default(autoincrement())

  // Sin @unique: unicidad solo entre activos, la valida el service.
  nombre      String
  descripcion String?

  // Igual que en TIPOCOMPROBANTE: se fija en el alta y queda bloqueado de
  // forma permanente por el service.
  requiere_referencia Boolean

  // Sprint 3 (HU-29): subconjunto de las formas activas que se ofrecen al
  // cliente para autogestión de pagos online. Se administra desde este mismo
  // ABM, sin pantalla nueva. Si estado = false, no se ofrece aunque esté
  // habilitada.
  habilitada_autogestion Boolean @default(false)

  estado Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("FormaPagoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("FormaPagoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  pagos         PAGO[]
  cobros        COBRO[]
  declaraciones DECLARACIONPAGO[]

  @@index([estado])
}

// --------------------------------------------------------------------------
// HU-16 — Comprobantes de proveedor
// --------------------------------------------------------------------------
// Se llama COMPROBANTEPROVEEDOR y no COMPROBANTE a secas porque el módulo de
// Comercialización y Ventas va a necesitar sus propios comprobantes de cliente.
model COMPROBANTEPROVEEDOR {
  id_comprobante_proveedor Int @id @default(autoincrement())

  // letra, punto_de_venta y numero los imprime el proveedor y los carga el
  // usuario a mano: son la única numeración del sprint que no genera el
  // sistema. La letra es del comprobante, no del tipo.
  letra          String @db.VarChar(1)
  punto_de_venta Int
  numero         Int

  // No admite fechas futuras (validación en service).
  fecha_emision     DateTime
  // No puede ser anterior a la de emisión (validación en service).
  fecha_vencimiento DateTime

  // Importes. Una sola alícuota de IVA por comprobante.
  importe_neto  Decimal @db.Decimal(14, 2) // suma de subtotales del detalle
  alicuota_iva  Decimal @db.Decimal(5, 2) // porcentaje, no un importe
  importe_iva   Decimal @db.Decimal(14, 2)
  importe_total Decimal @db.Decimal(14, 2)

  // Nullable a propósito: solo los comprobantes cuyo tipo aumenta el saldo
  // (TIPOCOMPROBANTE.aumenta_saldo = true) llevan saldo propio. Los que lo
  // disminuyen aplican su importe sobre el comprobante de origen y no quedan
  // disponibles para imputación.
  saldo_pendiente Decimal? @db.Decimal(14, 2)

  // Dos estados independientes: el del documento y el de su saldo.
  estado          EstadoComprobante @default(BORRADOR)
  // Estado del saldo. Boolean y no enum por el mismo criterio que
  // TIPOCOMPROBANTE.aumenta_saldo: son solo dos valores. Nullable porque solo
  // aplica a comprobantes REGISTRADOS cuyo tipo aumenta el saldo.
  saldo_cancelado Boolean? // Saldo cancelado (true) o pendiente (false)

  observaciones    String?
  // Obligatorio a nivel de service al anular.
  motivo_anulacion String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_proveedor            Int
  FK_tipo_comprobante     Int
  // Orden de compra vinculada, opcional.
  FK_orden_compra         Int?
  // Autorreferencia: la nota de crédito o débito apunta al comprobante sobre
  // el que se aplica. Es obligatoria cuando el tipo lo requiere, y el service
  // valida además que pertenezca al mismo proveedor.
  FK_comprobante_origen   Int?
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  proveedor           PROVEEDOR       @relation(fields: [FK_proveedor], references: [id_proveedor])
  tipoComprobante     TIPOCOMPROBANTE @relation(fields: [FK_tipo_comprobante], references: [id_tipo_comprobante])
  ordenCompra         ORDENCOMPRA?    @relation(fields: [FK_orden_compra], references: [id_orden_compra])
  usuarioCreador      USUARIO         @relation("ComprobanteProveedorCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO         @relation("ComprobanteProveedorActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  comprobante_origen COMPROBANTEPROVEEDOR?  @relation("NotasAplicadas", fields: [FK_comprobante_origen], references: [id_comprobante_proveedor])
  notas_aplicadas    COMPROBANTEPROVEEDOR[] @relation("NotasAplicadas")

  detalles     DETALLECOMPROBANTE[]
  detallesPago DETALLEPAGO[]

  // NO es @@unique a propósito, aunque la combinación identifique al
  // comprobante: el criterio de aceptación habla de comprobantes *vigentes*
  // (excluye los anulados), y un único de base impediría volver a cargar un
  // comprobante después de anularlo por un error de tipeo en el número. La
  // validación la hace el service antes de confirmar; este índice está para
  // que esa verificación sea una búsqueda indexada y no un scan de la tabla.
  // No convertirlo en @@unique en una PR futura.
  @@index([FK_proveedor, FK_tipo_comprobante, letra, punto_de_venta, numero])
  @@index([FK_proveedor])
  @@index([estado])
  @@index([saldo_cancelado])
  @@index([fecha_emision])
  @@index([fecha_vencimiento])
}

model DETALLECOMPROBANTE {
  id_detalle_comprobante Int @id @default(autoincrement())

  FK_comprobante_proveedor Int

  // La descripción es obligatoria y el artículo opcional: un comprobante puede
  // tener líneas que no correspondan a un artículo de Almacén (fletes,
  // servicios, etc.).
  descripcion String
  FK_articulo Int?

  cantidad        Decimal @db.Decimal(14, 2)
  precio_unitario Decimal @db.Decimal(14, 2)
  subtotal        Decimal @db.Decimal(14, 2)

  comprobante COMPROBANTEPROVEEDOR @relation(fields: [FK_comprobante_proveedor], references: [id_comprobante_proveedor], onDelete: Cascade)
  articulo    ARTICULO?            @relation(fields: [FK_articulo], references: [id_articulo])
}

// --------------------------------------------------------------------------
// HU-18 — Pagos
// --------------------------------------------------------------------------
model PAGO {
  // El número del pago es esta PK: no hay campo `numero`. El documento
  // imprimible "orden de pago" se emite a partir de un pago confirmado y
  // lleva este mismo número — no es una entidad aparte.
  id_pago Int @id @default(autoincrement())

  fecha_pago DateTime

  // Obligatorio a nivel de service cuando la forma de pago lo requiere.
  numero_referencia String?

  // Suma de las imputaciones del detalle, la calcula el sistema.
  importe_total Decimal    @default(0) @db.Decimal(14, 2)
  observaciones String?
  estado        EstadoPago @default(BORRADOR)

  // Obligatorio a nivel de service al anular.
  motivo_anulacion String?

  // Foto de los datos bancarios del proveedor (HU-12) al momento de
  // confirmar, para que una edición posterior de la ficha del proveedor no
  // altere un documento ya emitido — mismo criterio que
  // DETALLEPAGO.saldo_anterior/saldo_posterior, pero de datos en vez de
  // importes. Se copian de PROVEEDOR.banco/titular/cbu/alias; son nullable
  // porque en el proveedor también son opcionales.
  banco_utilizado   String?
  titular_utilizado String?
  cbu_utilizado     String?
  alias_utilizado   String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_proveedor            Int
  FK_forma_pago           Int
  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  proveedor           PROVEEDOR @relation(fields: [FK_proveedor], references: [id_proveedor])
  formaPago           FORMAPAGO @relation(fields: [FK_forma_pago], references: [id_forma_pago])
  usuarioCreador      USUARIO   @relation("PagoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO   @relation("PagoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  detalles DETALLEPAGO[]

  @@index([FK_proveedor])
  @@index([FK_forma_pago])
  @@index([estado])
  @@index([fecha_pago])
}

model DETALLEPAGO {
  id_detalle_pago Int @id @default(autoincrement())

  FK_pago                  Int
  FK_comprobante_proveedor Int

  importe_imputado Decimal @db.Decimal(14, 2)

  // Foto del saldo del comprobante al momento de confirmar el pago. Se
  // conservan tal cual y NUNCA se recalculan al consultarlos: el service de
  // la cuenta corriente los lee, no los deriva. Mismo criterio que
  // STOCKMOVIMIENTO.stock_anterior / stock_nuevo.
  saldo_anterior  Decimal @db.Decimal(14, 2)
  saldo_posterior Decimal @db.Decimal(14, 2)

  pago        PAGO                 @relation(fields: [FK_pago], references: [id_pago], onDelete: Cascade)
  comprobante COMPROBANTEPROVEEDOR @relation(fields: [FK_comprobante_proveedor], references: [id_comprobante_proveedor])

  // Un mismo comprobante no puede imputarse dos veces en el mismo pago.
  @@unique([FK_pago, FK_comprobante_proveedor])
}

// ============================================================================
// COMERCIALIZACIÓN / ECOMMERCE (Sprint 3) — HU-19 a HU-30
// ============================================================================
// Cadena principal: PROYECTO → UNIDADFUNCIONAL → PUBLICACIONUNIDAD →
// PLANPAGO → VENTA → CUOTA → DETALLECOBRO. Ver el DER del sprint para el
// diagrama completo, los valores derivados que a propósito no son columna
// (presupuesto, costo congelado, precio "desde", saldo pendiente, cuota
// vencida, condición de entrega, proyectos destacados) y las 8 decisiones de
// diseño cerradas con el equipo.

enum EstadoProyecto {
  EN_PLANIFICACION
  EN_EJECUCION
  FINALIZADO
  CANCELADO
}

enum TipologiaUnidad {
  MONOAMBIENTE
  UN_DORMITORIO
  DOS_DORMITORIOS
  TRES_DORMITORIOS
  LOCAL_COMERCIAL
  COCHERA
  OTRO
}

enum EstadoComercial {
  EN_PREPARACION
  DISPONIBLE
  EN_PLAN_DE_PAGO
  VENDIDA
}

enum TipoPlanPago {
  CONTADO
  FINANCIADO
}

enum Periodicidad {
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum EstadoVenta {
  VIGENTE
  CANCELADA
}

enum EstadoCuota {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

enum EstadoConsulta {
  PENDIENTE
  RESPONDIDA
}

enum EstadoDeclaracionPago {
  PENDIENTE
  VALIDADA
  RECHAZADA
}

enum OrigenCobro {
  PRESENCIAL
  ECOMMERCE
}

// Simétrico a EstadoPago. BORRADOR solo lo usa el flujo PRESENCIAL de HU-30
// (Tesorería arma el cobro en varios pasos sin tocar saldos); el origen
// ECOMMERCE (HU-29) nace CONFIRMADO directo.
enum EstadoCobro {
  BORRADOR
  CONFIRMADO
  ANULADO
}

// --------------------------------------------------------------------------
// HU-20 — Unidades funcionales
// --------------------------------------------------------------------------
model UNIDADFUNCIONAL {
  id_unidad_funcional Int @id @default(autoincrement())

  FK_proyecto Int
  proyecto    PROYECTO @relation(fields: [FK_proyecto], references: [id_proyecto])

  // Único solo entre unidades activas del mismo proyecto (se valida a nivel
  // service, no acá) — mismo criterio que FORMAPAGO.nombre.
  identificador String

  tipologia TipologiaUnidad

  superficie_cubierta    Decimal  @db.Decimal(10, 2)
  superficie_descubierta Decimal? @db.Decimal(10, 2)
  // String y no Int: existe "PB".
  piso                   String?
  comodidades            String?
  observaciones          String?

  // Editable por Proyectos solo mientras la unidad nunca fue publicada.
  // Congelado desde la primera publicación (HU-20/HU-21): el service bloquea
  // la edición si ya existe al menos una fila histórica en PUBLICACIONUNIDAD
  // para esta unidad, aunque hoy no esté vigente. No hay columna
  // `costo_congelado`: se deriva de esa existencia, no se guarda.
  costo Decimal @db.Decimal(14, 2)

  // Baja lógica. No se puede dar de baja una unidad con publicación vigente
  // (regla de service).
  estado Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("UnidadFuncionalCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("UnidadFuncionalActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  imagenes      IMAGENUNIDAD[]
  publicaciones PUBLICACIONUNIDAD[]

  @@index([FK_proyecto])
  @@index([estado])
}

model IMAGENUNIDAD {
  id_imagen_unidad Int @id @default(autoincrement())

  FK_unidad_funcional Int
  unidadFuncional     UNIDADFUNCIONAL @relation(fields: [FK_unidad_funcional], references: [id_unidad_funcional], onDelete: Cascade)

  // Pública, sin versionado ni permisos: vive en el object storage del
  // sistema, acá solo se guarda la URL.
  url   String
  orden Int    @default(0)

  // Sin auditoría completa ni baja lógica: una imagen se borra físicamente,
  // no constituye historial financiero ni contractual.
  hora_creacion DateTime @default(now())

  @@index([FK_unidad_funcional])
}

// --------------------------------------------------------------------------
// HU-21 — Publicación de unidades en el ecommerce
// --------------------------------------------------------------------------
model PUBLICACIONUNIDAD {
  id_publicacion Int @id @default(autoincrement())

  // Varias filas por unidad: es el historial de publicaciones.
  FK_unidad_funcional Int
  unidadFuncional     UNIDADFUNCIONAL @relation(fields: [FK_unidad_funcional], references: [id_unidad_funcional])

  estado_comercial EstadoComercial @default(EN_PREPARACION)

  fecha_publicacion DateTime @default(now())

  // Solo una publicación vigente por unidad. Postgres lo resolvería con un
  // índice único parcial (WHERE vigente = true), que Prisma no expone en el
  // schema — agregar a mano en la migración generada. Mientras tanto lo
  // valida el service. No significa "se ve en el catálogo": el catálogo
  // filtra además por estado_comercial = DISPONIBLE (dos condiciones, no
  // una).
  vigente Boolean @default(true)

  fecha_despublicacion  DateTime?
  // Obligatorio a nivel de service al despublicar. Despublicar solo se
  // permite en EN_PREPARACION o DISPONIBLE (no en EN_PLAN_DE_PAGO ni VENDIDA).
  motivo_despublicacion String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("PublicacionCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("PublicacionActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  planes    PLANPAGO[]
  consultas CONSULTAUNIDAD[]
  ventas    VENTA[]

  @@index([FK_unidad_funcional])
  @@index([vigente, estado_comercial])
}

// --------------------------------------------------------------------------
// HU-22 — Planes de pago y margen de ganancia
// --------------------------------------------------------------------------
model PLANPAGO {
  id_plan_pago Int @id @default(autoincrement())

  // Cuelga de la publicación, no de la unidad: si colgara de la unidad,
  // VENTA tendría dos caminos paralelos hacia la misma unidad (FK_publicacion
  // y FK_plan_pago → FK_unidad_funcional) — un rombo que habría que validar a
  // mano para siempre.
  FK_publicacion Int
  publicacion    PUBLICACIONUNIDAD @relation(fields: [FK_publicacion], references: [id_publicacion])

  nombre String
  tipo   TipoPlanPago

  // Fuente de verdad del precio del plan: no está obligado a coincidir con
  // costo + costo*porcentaje_ganancia + margen. Esa fórmula es solo una
  // ayuda de cálculo que ofrece el formulario; Comercialización puede
  // escribir directamente el precio final que negoció.
  precio Decimal @db.Decimal(14, 2)

  porcentaje_ganancia Decimal @default(0) @db.Decimal(5, 2)
  margen              Decimal @default(0) @db.Decimal(14, 2)

  // Uno de los dos, nunca ambos — lo valida el service. En CONTADO el
  // anticipo equivale al 100% del precio.
  anticipo_porcentaje Decimal? @db.Decimal(5, 2)
  anticipo_monto      Decimal? @db.Decimal(14, 2)

  // Solo aplican a FINANCIADO.
  cantidad_cuotas Int?
  periodicidad    Periodicidad?

  // Activo/inactivo. Sin ningún plan activo, la publicación vuelve a
  // EN_PREPARACION (regla de service).
  //
  // Condiciones estructurales inmutables una vez creado el plan: tipo,
  // anticipo_porcentaje/anticipo_monto, cantidad_cuotas y periodicidad no se
  // editan — para ofrecer condiciones distintas se inactiva este plan y se
  // crea uno nuevo. Sí son editables mientras el plan esté activo: precio,
  // porcentaje_ganancia, margen y este mismo estado.
  estado Boolean @default(true)

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("PlanPagoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("PlanPagoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  historial PLANPAGOHISTORIAL[]
  ventas    VENTA[]

  @@index([FK_publicacion])
  @@index([estado])
}

// Una fila por cada edición del plan, con el antes y el después de las
// cuatro cosas que importan (no trackea campo por campo: cada edición genera
// una sola fila con la foto completa). La creación de un plan nuevo no
// genera fila acá (no hay "antes" que registrar) — queda cubierta por la
// auditoría estándar de PLANPAGO.
model PLANPAGOHISTORIAL {
  id_historial Int @id @default(autoincrement())

  FK_plan_pago Int
  // Restrict, no Cascade: es historial de auditoría, nunca se borra en
  // cascada aunque el plan se elimine.
  planPago     PLANPAGO @relation(fields: [FK_plan_pago], references: [id_plan_pago], onDelete: Restrict)

  precio_anterior Decimal @db.Decimal(14, 2)
  precio_nuevo    Decimal @db.Decimal(14, 2)

  porcentaje_ganancia_anterior Decimal @db.Decimal(5, 2)
  porcentaje_ganancia_nuevo    Decimal @db.Decimal(5, 2)

  margen_anterior Decimal @db.Decimal(14, 2)
  margen_nuevo    Decimal @db.Decimal(14, 2)

  // Activo/inactivo, también queda en el historial.
  estado_anterior Boolean
  estado_nuevo    Boolean

  FK_usuario Int
  usuario    USUARIO @relation("PlanPagoHistorialUsuario", fields: [FK_usuario], references: [id_usuario])

  // Append-only: cada fila es un evento cerrado, sin hora_actualizacion ni
  // FK_usuario_actualizador (mismo criterio que ORDENCOMPRAHISTORIALESTADO).
  hora_creacion DateTime @default(now())

  @@index([FK_plan_pago])
}

// --------------------------------------------------------------------------
// HU-27 — Adhesión del cliente a un plan de pago
// --------------------------------------------------------------------------
model VENTA {
  id_venta Int @id @default(autoincrement())

  FK_cliente Int
  cliente    CLIENTE @relation(fields: [FK_cliente], references: [id_cliente])

  // Una sola venta VIGENTE por publicación (se valida a nivel service).
  FK_publicacion Int
  publicacion    PUBLICACIONUNIDAD @relation(fields: [FK_publicacion], references: [id_publicacion])

  // Regla de integridad crítica, validada dentro de la misma transacción de
  // adhesión: FK_plan_pago tiene que pertenecer a esta misma FK_publicacion
  // (PLANPAGO.FK_publicacion == VENTA.FK_publicacion). Prisma no expone un
  // constraint que cruce dos FK de la misma fila, así que la transacción
  // valida en orden: 1) publicación vigente · 2) estado_comercial =
  // DISPONIBLE · 3) plan activo · 4) esta coherencia · recién ahí 5) crea la
  // venta · 6) genera las cuotas · 7) pasa estado_comercial a
  // EN_PLAN_DE_PAGO. Si cualquier paso falla, se revierte todo.
  FK_plan_pago Int
  planPago     PLANPAGO @relation(fields: [FK_plan_pago], references: [id_plan_pago])

  fecha_adhesion DateTime @default(now())

  // Condiciones congeladas al momento de la adhesión: si el plan se edita o
  // inactiva después, esta operación no se entera.
  precio_congelado          Decimal       @db.Decimal(14, 2)
  anticipo_congelado        Decimal       @db.Decimal(14, 2)
  tipo_plan_congelado       TipoPlanPago
  cantidad_cuotas_congelada Int
  periodicidad_congelada    Periodicidad?

  estado EstadoVenta @default(VIGENTE)

  // Obligatorio a nivel de service al cancelar. Al cancelar, las cuotas
  // generadas quedan ANULADA (sin eliminarse físicamente) y la unidad vuelve
  // a DISPONIBLE.
  motivo_cancelacion String?
  fecha_cancelacion  DateTime?

  // El autor lógico es el CLIENTE, no un USUARIO: no hay FK_usuario_creador.
  hora_creacion DateTime @default(now())

  cuotas CUOTA[]

  @@index([FK_cliente])
  @@index([FK_publicacion])
  @@index([FK_plan_pago])
  @@index([estado])
}

// El cronograma que se genera al confirmar una adhesión. Es el único lugar
// donde vive el saldo: el saldo total pendiente de la venta es la suma de
// estas filas.
model CUOTA {
  id_cuota Int @id @default(autoincrement())

  FK_venta Int
  // Restrict, no Cascade: es historial financiero, nunca se borra en
  // cascada aunque la venta se elimine.
  venta    VENTA @relation(fields: [FK_venta], references: [id_venta], onDelete: Restrict)

  // 0 = anticipo, o el 100% del precio en un plan CONTADO.
  numero Int

  // La diferencia de redondeo del reparto en partes iguales se ajusta en la
  // última cuota.
  importe Decimal @db.Decimal(14, 2)

  // Si el día no existe en el mes de destino, vence el último día de ese mes.
  fecha_vencimiento DateTime

  // Baja con cada imputación de COBRO/DETALLECOBRO.
  saldo_pendiente Decimal @db.Decimal(14, 2)

  estado EstadoCuota @default(PENDIENTE)

  detallesCobro     DETALLECOBRO[]
  declaracionesPago DECLARACIONPAGO[]

  @@unique([FK_venta, numero])
  // Lo pide la consulta de cuotas vencidas de HU-30.
  @@index([fecha_vencimiento, estado])
}

// --------------------------------------------------------------------------
// HU-26 — Consultas de clientes sobre unidades publicadas
// --------------------------------------------------------------------------
// Pregunta del cliente y respuesta de Comercialización en la misma fila: a
// lo sumo una respuesta y, una vez enviada, no se edita. No se borran nunca,
// ni siquiera si la unidad se despublica.
model CONSULTAUNIDAD {
  id_consulta Int @id @default(autoincrement())

  FK_cliente Int
  cliente    CLIENTE @relation(fields: [FK_cliente], references: [id_cliente])

  FK_publicacion Int
  publicacion    PUBLICACIONUNIDAD @relation(fields: [FK_publicacion], references: [id_publicacion])

  // Largo máximo validado en el DTO Zod, no en la base.
  texto String

  // PENDIENTE → RESPONDIDA, sin vuelta atrás.
  estado EstadoConsulta @default(PENDIENTE)

  respuesta       String?
  fecha_respuesta DateTime?

  FK_usuario_respuesta Int?
  usuarioRespuesta     USUARIO? @relation("ConsultaUnidadRespuesta", fields: [FK_usuario_respuesta], references: [id_usuario])

  hora_creacion DateTime @default(now())

  @@index([FK_publicacion])
  @@index([FK_cliente])
  @@index([estado])
}

// --------------------------------------------------------------------------
// HU-23 — Registro e inicio de sesión de clientes
// --------------------------------------------------------------------------
// Entidad separada de USUARIO a propósito: un cliente no tiene rol, no tiene
// contraseña y nunca entra a una pantalla interna. Se autocrea en el primer
// login con Google.
model CLIENTE {
  id_cliente Int @id @default(autoincrement())

  // Id estable de la cuenta de Google — el mail puede cambiar, esto no.
  google_sub String @unique
  // Identifica al cliente de forma unívoca; evita duplicados.
  email      String @unique

  nombre   String
  // Google no siempre lo manda separado del nombre.
  apellido String?

  // Null hasta que el cliente lo completa; obligatorio antes de adherirse a
  // un plan (HU-27) o declarar un pago (HU-29). Único entre clientes.
  dni_cuil String? @unique
  telefono String?

  // Mismo esquema de doble token que USUARIO. Sin columna `password`: no hay
  // recuperación de contraseña porque no hay contraseña.
  refreshTokenHash String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  consultas     CONSULTAUNIDAD[]
  ventas        VENTA[]
  declaraciones DECLARACIONPAGO[]
  cobros        COBRO[]
}

// --------------------------------------------------------------------------
// HU-30 — Registro de cobranzas a clientes
// --------------------------------------------------------------------------
// Espejo de PAGO, del otro lado del mostrador: una sola entidad para el
// cobro presencial (HU-30) y para el pago validado del ecommerce (HU-29),
// distinguidos por `origen`.
model COBRO {
  // El número de recibo que ve el usuario es esta PK, mismo criterio que PAGO.
  id_cobro Int @id @default(autoincrement())

  fecha_cobro DateTime

  FK_cliente Int
  cliente    CLIENTE @relation(fields: [FK_cliente], references: [id_cliente])

  FK_forma_pago Int
  formaPago     FORMAPAGO @relation(fields: [FK_forma_pago], references: [id_forma_pago])

  // Obligatorio a nivel de service si la forma de pago lo requiere.
  numero_referencia String?

  // Debe coincidir exacto con la suma del detalle (validación de service).
  importe_total Decimal @db.Decimal(14, 2)
  observaciones String?

  origen OrigenCobro
  estado EstadoCobro @default(BORRADOR)

  // Obligatorio a nivel de service al anular. Anular restituye el saldo de
  // cada cuota imputada y puede devolver la unidad de VENDIDA a
  // EN_PLAN_DE_PAGO si el saldo total de la venta vuelve a ser mayor a cero.
  motivo_anulacion String?

  hora_creacion      DateTime  @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador      Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("CobroCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("CobroActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  detalles        DETALLECOBRO[]
  declaracionPago DECLARACIONPAGO?

  @@index([FK_cliente])
  @@index([FK_forma_pago])
  @@index([estado])
  @@index([fecha_cobro])
}

// Calcado de DETALLEPAGO, incluida la foto del saldo antes y después: se
// guarda y nunca se recalcula al consultar.
model DETALLECOBRO {
  id_detalle_cobro Int @id @default(autoincrement())

  FK_cobro Int
  // Restrict, no Cascade: es historial financiero, nunca se borra en
  // cascada aunque el cobro se elimine.
  cobro    COBRO @relation(fields: [FK_cobro], references: [id_cobro], onDelete: Restrict)

  FK_cuota Int
  cuota    CUOTA @relation(fields: [FK_cuota], references: [id_cuota])

  // Mayor a cero y nunca superior al saldo pendiente de la cuota (validación
  // de service).
  importe_imputado Decimal @db.Decimal(14, 2)

  // Foto del saldo antes/después: se guarda y nunca se recalcula al
  // consultar (mismo criterio que DETALLEPAGO / STOCKMOVIMIENTO).
  saldo_anterior  Decimal @db.Decimal(14, 2)
  saldo_posterior Decimal @db.Decimal(14, 2)

  @@unique([FK_cobro, FK_cuota])
}

// --------------------------------------------------------------------------
// HU-29 — Declaración y validación de pagos online
// --------------------------------------------------------------------------
// Lo que el cliente dice que pagó. No mueve ningún saldo hasta que Tesorería
// la valida; recién ahí nace un COBRO de origen ECOMMERCE.
model DECLARACIONPAGO {
  id_declaracion_pago Int @id @default(autoincrement())

  // Solo sobre adhesiones propias.
  FK_cliente Int
  cliente    CLIENTE @relation(fields: [FK_cliente], references: [id_cliente])

  // Pendiente o parcial, nunca saldada (validación de service).
  FK_cuota Int
  cuota    CUOTA @relation(fields: [FK_cuota], references: [id_cuota])

  // Solo las formas habilitadas para autogestión.
  FK_forma_pago Int
  formaPago     FORMAPAGO @relation(fields: [FK_forma_pago], references: [id_forma_pago])

  importe Decimal @db.Decimal(14, 2)

  // Lo que Tesorería cruza contra el extracto bancario. No hay adjuntos.
  numero_referencia String?

  estado EstadoDeclaracionPago @default(PENDIENTE)

  // Obligatorio a nivel de service al rechazar. RECHAZADA permite volver a
  // declarar.
  motivo_rechazo   String?
  fecha_resolucion DateTime?

  FK_usuario_validador Int?
  usuarioValidador     USUARIO? @relation("DeclaracionPagoValidador", fields: [FK_usuario_validador], references: [id_usuario])

  // El cobro que generó al validarse. Si ese cobro se anula después, esta
  // declaración sigue VALIDADA como registro histórico y sigue apuntando
  // acá — no se agrega un cuarto estado a EstadoDeclaracionPago.
  FK_cobro Int?   @unique
  cobro    COBRO? @relation(fields: [FK_cobro], references: [id_cobro])

  hora_creacion DateTime @default(now())

  @@index([FK_cliente])
  @@index([FK_cuota])
  @@index([estado])
}
