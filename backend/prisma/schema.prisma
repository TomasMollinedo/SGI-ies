// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model USUARIO {
  id_usuario Int    @id @default(autoincrement())
  nombre     String
  apellido   String
  email      String @unique
  password   String // hash de bcrypt, nunca texto plano

  FK_rol Int
  rol    ROL @relation(fields: [FK_rol], references: [id_rol])

  refreshTokenHash String? // hash bcrypt del refresh token vigente; null si no hay sesión activa
  dni  String @unique

  // Relaciones
  tiposMovimientoCreados    TIPOMOVIMIENTO[] @relation("TipoMovimientoCreador")
  tiposMovimientoActualizados TIPOMOVIMIENTO[] @relation("TipoMovimientoActualizador")

  movimientosCreados        MOVIMIENTO[] @relation("MovimientoCreador")
  movimientosActualizados   MOVIMIENTO[] @relation("MovimientoActualizador")

  articulosCreados          ARTICULO[] @relation("ArticuloCreador")
  articulosActualizados     ARTICULO[] @relation("ArticuloActualizador")

  categoriasCreadas         CATEGORIA[] @relation("CategoriaCreador")
  categoriasActualizadas    CATEGORIA[] @relation("CategoriaActualizador")

  marcasCreadas             MARCA[] @relation("MarcaCreador")
  marcasActualizadas        MARCA[] @relation("MarcaActualizador")

  unidadesMedidaCreadas     UNIDADMEDIDA[] @relation("UnidadMedidaCreador")
  unidadesMedidaActualizadas UNIDADMEDIDA[] @relation("UnidadMedidaActualizador")

  depositosCreados          DEPOSITO[] @relation("DepositoCreador")
  depositosActualizados     DEPOSITO[] @relation("DepositoActualizador")
}

model ROL {
  id_rol Int    @id @default(autoincrement())
  nombre String @unique

  usuarios USUARIO[]
}

model TIPOMOVIMIENTO {
  id_tipo_movimiento Int @id @default(autoincrement())
  nombre             String @unique
  indicador_entrada    Boolean // Indica si el movimiento es de entrada (true) o de salida (false)
  estado             Boolean @default(true)
  
  hora_creacion DateTime @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador    Int
  FK_usuario_actualizador Int

  usuarioCreador    USUARIO @relation("TipoMovimientoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("TipoMovimientoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  movimientos MOVIMIENTO[]
}

model MOVIMIENTO {
  id_movimiento Int @id @default(autoincrement())

  FK_TipoMovimiento  Int
  FK_usuario_creador Int
  FK_usuario_actualizador Int

  tipoMovimiento    TIPOMOVIMIENTO @relation(fields: [FK_TipoMovimiento], references: [id_tipo_movimiento])
  usuarioCreador    USUARIO        @relation("MovimientoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO      @relation("MovimientoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stockMovimientos STOCKMOVIMIENTO[]
}

model STOCKMOVIMIENTO {
  id_stock_movimiento Int @id @default(autoincrement())

  FK_Movimiento Int
  FK_Stock      Int

  movimiento MOVIMIENTO @relation(fields: [FK_Movimiento], references: [id_movimiento])
  stock      STOCK      @relation(fields: [FK_Stock], references: [id_stock])
}

model STOCK {
  id_stock Int @id @default(autoincrement())

  FK_deposito Int
  FK_articulo Int

  deposito DEPOSITO @relation(fields: [FK_deposito], references: [id_deposito])
  articulo ARTICULO @relation(fields: [FK_articulo], references: [id_articulo])

  stockMovimientos STOCKMOVIMIENTO[]
}

model ARTICULO {
  id_articulo Int @id @default(autoincrement())
  activo     Boolean @default(true)

  FK_Categoria       Int
  FK_Marca           Int
  FK_UnidadMedida    Int
  FK_usuario_creador Int
  FK_usuario_actualizador Int

  categoria       CATEGORIA    @relation(fields: [FK_Categoria], references: [id_categoria])
  marca           MARCA        @relation(fields: [FK_Marca], references: [id_marca])
  unidadMedida    UNIDADMEDIDA @relation(fields: [FK_UnidadMedida], references: [id_unidad_medida])

  usuarioCreador      USUARIO @relation("ArticuloCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("ArticuloActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stocks STOCK[]
}

model CATEGORIA {
  id_categoria Int @id @default(autoincrement())
  nombre       String @unique
  descripcion  String?
  estado       Boolean @default(true)

  hora_creacion DateTime @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador     Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("CategoriaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("CategoriaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model MARCA {
  id_marca Int @id @default(autoincrement())
  // Único solo entre marcas activas (se valida a nivel service, no acá):
  // una marca dada de baja libera su nombre para una marca nueva.
  nombre   String
  descripcion  String?
  estado   Boolean @default(true)

  hora_creacion DateTime @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador     Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("MarcaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("MarcaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model UNIDADMEDIDA {
  id_unidad_medida Int @id @default(autoincrement())
  nombre           String @unique
  abreviatura      String @unique // Abreviatura de la unidad de medida (ejemplo: kg, m, l, etc.)
  estado           Boolean @default(true)

  hora_creacion DateTime @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador     Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("UnidadMedidaCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("UnidadMedidaActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  articulos ARTICULO[]
}

model DEPOSITO {
  id_deposito Int @id @default(autoincrement())
  nombre      String @unique
  es_obrador Boolean @default(false)
  ubicacion   String?
  descripcion String?
  estado     Boolean @default(true)
  //Agregar en su momento la vinculacion con proyecto, sera opcional, ya que puede haber depositos que no esten vinculados a ningun proyecto

  hora_creacion DateTime @default(now())
  hora_actualizacion DateTime? @default(now())

  FK_usuario_creador     Int
  FK_usuario_actualizador Int

  usuarioCreador      USUARIO @relation("DepositoCreador", fields: [FK_usuario_creador], references: [id_usuario])
  usuarioActualizador USUARIO @relation("DepositoActualizador", fields: [FK_usuario_actualizador], references: [id_usuario])

  stocks STOCK[]
}